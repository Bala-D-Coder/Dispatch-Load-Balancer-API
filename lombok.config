# Lombok ships code that nobody wrote by hand (getters, setters, builders, equals/hashCode) in
# entity/OrderEntity, entity/VehicleEntity and entity/common/GeoPoint. Tagging that output
# @lombok.Generated lets JaCoCo filter it — the rules use LINE counters only, so without this the
# gate would mostly measure accessor count. Rules live in pom.xml.
config.stopBubbling = true
lombok.addLombokGeneratedAnnotation = true
